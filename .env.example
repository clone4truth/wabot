[TEMPLATE]
APP_PORT=3000
APP_ENV=development
LOG_LEVEL=info

WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-api-key-here
WAHA_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=key
# URL bot /webhooks yang dapat diakses dari server/container WAHA.
# Wajib saat dashboard membuat sesi baru; sesi lama memakai webhook yang sudah ada.
WAHA_BOT_WEBHOOK_URL=

COMMAND_PREFIX=!
ALLOWED_CHAT_IDS=
BLOCKED_SENDER_IDS=
GROUP_ADMIN_ONLY=false

MAX_TEXT_LENGTH=300
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_DURATION_SECONDS=10

TEXT_PROCESSING_TIMEOUT_MS=5000
IMAGE_PROCESSING_TIMEOUT_MS=10000
VIDEO_PROCESSING_TIMEOUT_MS=30000

USER_RATE_LIMIT=8
GROUP_RATE_LIMIT=30
VIDEO_CONCURRENCY_PER_USER=2

TEMP_DIR=/tmp/waha-sticker-bot
TEMP_FILE_TTL_SECONDS=300

DATA_DIR=./data

# Global Concurrency & Job Manager
# JobManager adalah pemilik SATU-SATUNYA kendali konkurensi background job.
MAX_IMAGE_JOBS=4
MAX_VIDEO_JOBS=2
MAX_BACKGROUND_JOBS=1
MAX_ANIMATION_JOBS=2
MAX_IMAGE_QUEUE=50
MAX_VIDEO_QUEUE=20
MAX_ANIMATION_QUEUE=20
MAX_BACKGROUND_QUEUE=10
JOB_HISTORY_TTL_SECONDS=3600

# Background Removal (disabled | local | api)
BACKGROUND_REMOVAL_PROVIDER=disabled
BACKGROUND_REMOVAL_API_URL=
BACKGROUND_REMOVAL_API_KEY=
BACKGROUND_REMOVAL_TIMEOUT_MS=30000
BACKGROUND_REMOVAL_MAX_RESPONSE_BYTES=20971520
# Batas piksel Sharp saat validasi respons BG API (cegah pixel bomb).
BACKGROUND_REMOVAL_MAX_PIXELS=25000000

# Avatar (profile picture) safe fetcher
# Batas byte body avatar fetch.
AVATAR_MAX_BYTES=2097152
# Batas piksel Sharp saat validasi avatar.
AVATAR_MAX_PIXELS=16000000

# Runtime Tuning (WAJIB untuk VPS kecil — mencegah server overload)
# Jumlah thread libvips per gambar. Default Sharp = jumlah CPU core; pada Alpine
# (musl) NILAI INI TIDAK DIKLEM ke 1, jadi 4 image job x 4 core = 16 thread.
SHARP_CONCURRENCY=1
# Kuota cache operasi libvips (MB). Default Sharp 50MB + 20 file descriptor
# yang dipegang SELURUH umur proses.
SHARP_CACHE_MEMORY_MB=16
# 0 = jangan cache file sama sekali (bebaskan 20 FD).
SHARP_CACHE_FILES=0
# Batas piksel input untuk SEMUA decode Sharp. Default Sharp 268 juta (~1.07 GB
# RGBA per gambar!) — ini yang membuat sticker 16384x16384 jadi OOM.
MAX_INPUT_PIXELS=25000000

# Batch Processing
BATCH_MAX_ITEMS=10
BATCH_CONCURRENCY=2

# Dashboard admin (Vue + shadcn-vue, disajikan di /dashboard)
# Password login panel admin. KOSONGKAN untuk mematikan dashboard sepenuhnya.
ADMIN_PASSWORD=
# Lokasi build SPA. Default: ./dashboard-dist (sudah di-copy ke image).
DASHBOARD_DIST=./dashboard-dist
