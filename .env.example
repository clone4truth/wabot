APP_PORT=3000
APP_ENV=development
LOG_LEVEL=info

WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-api-key-here
WAHA_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=key

COMMAND_PREFIX=!

MAX_TEXT_LENGTH=300
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_DURATION_SECONDS=10

TEXT_PROCESSING_TIMEOUT_MS=5000
IMAGE_PROCESSING_TIMEOUT_MS=10000
VIDEO_PROCESSING_TIMEOUT_MS=30000

USER_RATE_LIMIT=8
GROUP_RATE_LIMIT=30
VIDEO_CONCURRENCY_PER_USER=2

TEMP_DIR=/tmp/waha-sticker-bot
TEMP_FILE_TTL_SECONDS=300
